# Copia este archivo como .env.local si tu backend NO corre en el puerto 8000
VITE_API_TARGET=http://127.0.0.1:8010

# Mapa: por defecto se usan las teselas de OpenStreetMap (no piden llave).
# Para usar otro proveedor con tu API key, descomenta y pon tu llave:
# VITE_MAPA_TESELAS=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=TU_LLAVE
# VITE_MAPA_CREDITO=© MapTiler
